# Optional process environment variable for dashboard company discovery.
# Alternatively enter the key in the app's session-only Search connection form.
# .env files are not automatically loaded. Do not commit actual keys.
TAVILY_API_KEY=

# Optional process environment variable for initial lead classification and contractor verification.
# The OpenAI key can also be entered into the app and kept in memory for that server session.
OPENAI_API_KEY=
# Both AI stages are fixed in code to gpt-4o-mini so evaluation runs remain comparable.

# Optional, used for manual evidence enrichment and employee-contact enrichment after a lead passes the score gate.
# The contact button uses HarvestAPI's LinkedIn Company Employees Actor with a five-profile / $0.10 cap.
APIFY_API_TOKEN=
